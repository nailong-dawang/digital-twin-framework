#!/usr/bin/env python3
"""twin - digital-twin-framework 统一 CLI 入口.

Usage:
  twin init [--dir ~/.twin]   # 初始化分身目录结构
  twin status                  # 查看数据目录状态
  twin doctor                  # 自检：编译全部工具 + 调度冒烟测试
  twin backup                  # 快照 TWIN_HOME/data 到 backups/（tar.gz）
  twin restore [--list | <file>]  # 从备份恢复；默认最新；恢复前自动快照当前 data
  twin <tool> [args...]        # 调度到对应工具，如 twin mood roll / twin state check
"""
import os, sys, argparse, subprocess, tarfile, tempfile, glob
from datetime import datetime

TOOLS = ["state", "memory", "people", "threads", "opinions",
         "vibe", "context", "evolve-log", "heartbeat-lock",
         "heartbeat-log", "mood", "novelty", "rhythm"]

def twin_dir():
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

def init(target_dir):
    target = os.path.expanduser(target_dir)
    os.makedirs(os.path.join(target, "data"), exist_ok=True)
    # 写默认配置
    config_path = os.path.join(target, "config.yaml")
    if not os.path.exists(config_path):
        with open(config_path, "w") as f:
            f.write("""# 数字分身配置
identity:
  name: "Your Name"
  handle: "your_handle"
  bio: "开发者 | AI 博主"
  languages: ["zh", "en"]

heartbeat:
  interval_minutes: 30
  session_min_minutes: 15
  session_max_minutes: 30

paths:
  data_dir: "./data"
""")
    print(f"✓ 初始化完成: {target}")
    print(f"  配置文件: {config_path}")
    print(f"  数据目录: {target}/data")
    print()
    print("下一步:")
    print("  1. 编辑 config.yaml，填你的身份信息")
    print("  2. export TWIN_HOME=" + target)
    print("  3. 在 Muse 里创建 3 个 cron（模板见 templates/）")

def status():
    home = os.path.expanduser(os.getenv("TWIN_HOME", "~/.twin"))
    print(f"TWIN_HOME: {home}")
    data = os.path.join(home, "data")
    if not os.path.exists(data):
        print("  未初始化，运行: twin init")
        return
    import glob
    for f in sorted(glob.glob(os.path.join(data, "*.json*"))):
        print(f"  ✓ {os.path.basename(f)}")

def dispatch(tool, args):
    """把命令转发给 twin/<tool>.py，继承环境变量（含 TWIN_HOME）。"""
    path = os.path.join(twin_dir(), f"{tool}.py")
    if not os.path.exists(path):
        print(f"未知工具: {tool}\n", file=sys.stderr)
        print("可用工具: " + ", ".join(TOOLS), file=sys.stderr)
        sys.exit(2)
    os.execvpe(sys.executable, [sys.executable, path] + args, os.environ)

def backup():
    """快照 TWIN_HOME/data 为时间戳 tar.gz，存入 TWIN_HOME/backups/。"""
    home = os.path.expanduser(os.getenv("TWIN_HOME", "~/.twin"))
    dest = _do_backup(home)
    data = os.path.join(home, "data")
    n = sum(len(files) for _, _, files in os.walk(data))
    print(f"✓ 备份完成: {dest}（{n} 个文件）")

def _do_backup(home, label="backup"):
    """实际执行一次快照，返回 tarball 路径。"""
    data = os.path.join(home, "data")
    if not os.path.isdir(data):
        print(f"数据目录不存在: {data}（先运行 twin init）", file=sys.stderr)
        sys.exit(2)
    bdir = os.path.join(home, "backups")
    os.makedirs(bdir, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(bdir, f"twin-{label}-{ts}.tar.gz")
    with tarfile.open(dest, "w:gz") as tf:
        tf.add(data, arcname="data")
    return dest

def list_backups(home):
    bdir = os.path.join(home, "backups")
    return sorted(glob.glob(os.path.join(bdir, "twin-backup-*.tar.gz")))

def restore(args):
    home = os.path.expanduser(os.getenv("TWIN_HOME", "~/.twin"))
    data = os.path.join(home, "data")
    if args and args[0] == "--list":
        for b in list_backups(home):
            print(os.path.basename(b))
        return
    backups = list_backups(home)
    if args:
        cand = args[0]
        dest = cand if os.path.isabs(cand) else os.path.join(home, "backups", cand)
        if not os.path.isfile(dest):
            print(f"备份不存在: {cand}", file=sys.stderr)
            sys.exit(2)
    elif backups:
        dest = backups[-1]
    else:
        print("没有可用备份（先运行 twin backup）", file=sys.stderr)
        sys.exit(2)
    # 安全：先快照当前 data，再覆盖
    if os.path.isdir(data):
        pre = _do_backup(home, label="pre-restore")
        print(f"  已先快照当前数据: {os.path.basename(pre)}")
    import shutil
    shutil.rmtree(data, ignore_errors=True)
    with tarfile.open(dest) as tf:
        # 路径穿越防护：只允许 data/ 下的相对路径
        for m in tf.getmembers():
            p = os.path.normpath(m.name)
            if p.startswith("..") or os.path.isabs(p) or not (p == "data" or p.startswith("data/")):
                print(f"备份包含非法路径，已拒绝恢复: {m.name}", file=sys.stderr)
                sys.exit(3)
        tf.extractall(path=home)
    print(f"✓ 已从 {os.path.basename(dest)} 恢复到 {data}")

def _backup_smoke():
    """备份往返冒烟测试：在沙盒 TWIN_HOME 里备份并校验 tarball 可读。"""
    sandbox = tempfile.mkdtemp(prefix="twin-doctor-")
    data = os.path.join(sandbox, "data")
    os.makedirs(data)
    with open(os.path.join(data, "probe.json"), "w") as f:
        f.write("{}")
    env = dict(os.environ, TWIN_HOME=sandbox)
    r = subprocess.run([sys.executable, os.path.abspath(__file__), "backup"],
                       capture_output=True, text=True, env=env)
    hits = glob.glob(os.path.join(sandbox, "backups", "twin-backup-*.tar.gz"))
    ok = r.returncode == 0 and len(hits) == 1
    if ok:
        with tarfile.open(hits[0]) as tf:
            ok = "data/probe.json" in tf.getnames()
    return ok

def doctor():
    ok, fail = 0, 0
    for t in TOOLS:
        p = os.path.join(twin_dir(), f"{t}.py")
        r = subprocess.run([sys.executable, "-m", "py_compile", p],
                           capture_output=True)
        if r.returncode == 0:
            ok += 1
        else:
            fail += 1
            print(f"  ✗ {t}.py 编译失败")
    # 调度冒烟测试：走一次真实转发链路
    smoke = subprocess.run([sys.executable, os.path.abspath(__file__),
                            "mood", "roll"], capture_output=True, text=True)
    try:
        import json
        out = json.loads(smoke.stdout)
        assert "mood" in out
        print(f"  ✓ 调度冒烟测试通过 (twin mood roll -> {out['mood']})")
    except Exception:
        fail += 1
        print(f"  ✗ 调度冒烟测试失败: {smoke.stderr.strip()[:200]}")
    # 备份往返冒烟测试（沙盒，不污染真实 TWIN_HOME）
    try:
        if _backup_smoke():
            print("  ✓ 备份往返冒烟测试通过 (sandbox backup -> tarball 可读)")
        else:
            fail += 1
            print("  ✗ 备份往返冒烟测试失败")
    except Exception as e:
        fail += 1
        print(f"  ✗ 备份往返冒烟测试异常: {e}")
    print(f"自检: {ok} 通过, {fail} 失败")
    if fail:
        sys.exit(1)

def usage():
    print(__doc__.strip())
    print()
    print("可用工具:")
    print("  " + ", ".join(TOOLS))

if __name__ == "__main__":
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        sys.exit(0)
    cmd = argv[0]
    if cmd == "init":
        p = argparse.ArgumentParser()
        p.add_argument("--dir", default="~/.twin")
        a = p.parse_args(argv[1:])
        init(a.dir)
    elif cmd == "status":
        status()
    elif cmd == "doctor":
        doctor()
    elif cmd == "backup":
        backup()
    elif cmd == "restore":
        restore(argv[1:])
    else:
        dispatch(cmd, argv[1:])
